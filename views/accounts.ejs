<style>
    body {
  margin: 0;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  background: #0b1f33;
  color: #fff;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

.container {
  background: rgba(255, 255, 255, 0.03);
  padding: 45px 50px;
  border-radius: 14px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  max-width: 480px;
  width: 90%;
  text-align: center;
}

/* Brand */
.brand {
  font-size: 0.8rem;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: #00c6ff;
  margin-bottom: 14px;
  font-weight: 600;
}

/* Title */
h1 {
  margin-bottom: 25px;
  font-size: 2.3rem;
  font-weight: 600;
}

/* Info message */
.info-message {
  margin-bottom: 25px;
  color: #00c6ff;
  font-size: 0.95rem;
  opacity: 0.9;
}

/* Account list */
ul {
  list-style: none;
  padding: 0;
  margin: 0 0 30px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

li {
  background: rgba(255, 255, 255, 0.06);
  padding: 14px 18px;
  border-radius: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.95rem;
}

li strong {
  color: #00c6ff;
  font-weight: 600;
}

/* Link button */
a {
  display: inline-block;
  margin-top: 10px;
  background: #00c6ff;
  color: #001b2e;
  text-decoration: none;
  padding: 13px 22px;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 600;
  transition: 0.25s ease;
}

a:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0, 198, 255, 0.35);
}

</style>

<body>
  <div class="container">
    <div class="brand">Viking Bank</div>
    <h1>My Bank Accounts</h1>
    

    <% if (message) { %>
      <p class="info-message"><%= message %></p>
    <% } %>

    <% if (accounts && accounts.length > 0) { %>
      <ul>
        <% accounts.forEach(account => { %>
          <li>
            <strong><%= account.Aname %></strong> <%= account.balance %> NOK
          </li>
        <% }) %>
      </ul>
    <% } %>

    <a href="/dashboard">Create account</a>
    <a href="/transfer">Transfer money to a different account</a>
  </div>
</body>
