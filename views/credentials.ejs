<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Credentials — Viking Bank</title>
  <style>
    :root {
      --bg: #0b1f33;
      --panel: rgba(255, 255, 255, 0.04);
      --panel-strong: rgba(255, 255, 255, 0.08);
      --accent: #00c6ff;
      --accent-2: #66e3ff;
      --text: #f5fbff;
      --muted: rgba(245, 251, 255, 0.72);
      --border: rgba(255, 255, 255, 0.14);
      --shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
    }

    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      min-height: 100%;
    }

    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(0, 198, 255, 0.16), transparent 28%),
        radial-gradient(circle at bottom right, rgba(102, 227, 255, 0.08), transparent 24%),
        var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 36px 20px 110px;
    }

    .page {
      width: min(980px, 100%);
      margin: 0 auto;
    }

    .hero {
      display: grid;
      gap: 16px;
      margin-bottom: 24px;
    }

    .eyebrow {
      color: var(--accent);
      letter-spacing: 0.28em;
      text-transform: uppercase;
      font-size: 0.78rem;
      font-weight: 700;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.3rem, 4vw, 4.2rem);
      line-height: 1.02;
      max-width: 12ch;
    }

    .lead {
      margin: 0;
      max-width: 64ch;
      color: var(--muted);
      font-size: 1.03rem;
      line-height: 1.7;
    }

    .layout {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 22px;
      align-items: start;
      margin-top: 28px;
    }

    .card {
      background: linear-gradient(180deg, var(--panel), rgba(255, 255, 255, 0.025));
      border: 1px solid var(--border);
      border-radius: 22px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(10px);
    }

    .form-card {
      padding: 28px;
    }

    .field-grid {
      display: grid;
      gap: 16px;
      margin-top: 22px;
    }

    .field label {
      display: block;
      margin-bottom: 8px;
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--accent-2);
      letter-spacing: 0.02em;
    }

    .field input {
      width: 100%;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.06);
      color: var(--text);
      border-radius: 14px;
      padding: 15px 16px;
      font-size: 1rem;
      outline: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .field input::placeholder {
      color: rgba(245, 251, 255, 0.45);
    }

    .field input:focus {
      border-color: rgba(0, 198, 255, 0.9);
      box-shadow: 0 0 0 4px rgba(0, 198, 255, 0.16);
      transform: translateY(-1px);
    }

    .button-row {
      display: flex;
      gap: 12px;
      margin-top: 22px;
      flex-wrap: wrap;
    }

    .primary-btn,
    .ghost-btn {
      border: none;
      border-radius: 999px;
      padding: 13px 18px;
      font-size: 0.98rem;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
      cursor: pointer;
    }

    .primary-btn {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #001b2e;
      box-shadow: 0 14px 28px rgba(0, 198, 255, 0.24);
    }

    .ghost-btn {
      background: transparent;
      color: var(--text);
      border: 1px solid rgba(255, 255, 255, 0.18);
    }

    .primary-btn:hover,
    .ghost-btn:hover {
      transform: translateY(-2px);
    }

    .side-card {
      padding: 28px;
      display: grid;
      gap: 18px;
    }

    .side-title {
      font-size: 1.1rem;
      margin: 0;
      color: var(--accent-2);
    }

    .stat {
      background: var(--panel-strong);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 18px;
      padding: 16px;
    }

    .stat strong {
      display: block;
      font-size: 1.05rem;
      margin-bottom: 4px;
    }

    .stat span {
      color: var(--muted);
      font-size: 0.93rem;
    }

    .preview-value {
      display: block;
      margin-top: 8px;
      font-size: 1rem;
      color: var(--text);
      word-break: break-word;
    }

    .preview-value.muted {
      color: var(--muted);
    }

    .match-state {
      margin-top: 8px;
      font-size: 0.9rem;
      font-weight: 700;
    }

    .match-state.ok {
      color: #8ef0a3;
    }

    .match-state.warn {
      color: #ffcb6b;
    }

    .corner-button {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1000;
      border: none;
      border-radius: 999px;
      padding: 14px 18px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #001b2e;
      font-weight: 800;
      text-decoration: none;
      box-shadow: 0 16px 32px rgba(0, 198, 255, 0.25);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .corner-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 18px 36px rgba(0, 198, 255, 0.32);
    }

    .hint {
      margin-top: 14px;
      color: var(--muted);
      font-size: 0.88rem;
      line-height: 1.6;
    }

    .save-feedback {
      margin-top: 12px;
      margin-bottom: 4px;
      padding: 10px 12px;
      border-radius: 10px;
      border: 1px solid rgba(142, 240, 163, 0.4);
      background: rgba(142, 240, 163, 0.12);
      color: #8ef0a3;
      font-size: 0.9rem;
      font-weight: 700;
    }

    @media (max-width: 820px) {
      .layout {
        grid-template-columns: 1fr;
      }

      .corner-button {
        top: 16px;
        right: 16px;
      }
    }
  </style>
</head>
<body>
  <%- include('partials/floatingCredentialsButton') %>
  <a class="corner-button" href="/dashboard">Account Settings</a>

  <main class="page">
    <section class="hero">
      <div class="eyebrow">Viking Bank</div>
      <h1>Update your login details</h1>
      <p class="lead">
        This page is a visual mockup for changing your username and password. It has no backend and no form logic.
      </p>
    </section>

    <section class="layout">
      <div class="card form-card">
        <h2 style="margin:0;font-size:1.4rem;">Account Credentials</h2>
        <p class="hint" style="margin-top:10px;">
          Replace the placeholder values below with your new username and password when you're ready.
        </p>

        <% if (saved) { %>
          <div class="save-feedback">
            Saved input received for username: <%= typedUsername %>
          </div>
        <% } %>

        <form action="/credentials" method="post">
          <div class="field-grid">
            <div class="field">
              <label for="username">Current username</label>
              <input id="username" name="username" type="text" placeholder="Enter your username" />
            </div>

            <div class="field">
              <label for="newusername">New username</label>
              <input id="newusername" name="newusername" type="text" placeholder="Enter a new username" />
            </div>

            <div class="field">
              <label for="password">Password</label>
              <input id="password" name="password" type="password" placeholder="enter your password" />
            </div>
          </div>

          <div class="button-row">
            <button class="primary-btn" type="submit">Save Changes</button>
            <a class="ghost-btn" href="/accounts">Cancel</a>
          </div>
        </form>
      </div>

      <aside class="card side-card">
        <h2 class="side-title">What this page shows</h2>
        <div class="stat">
          <strong>Username</strong>
          <span>Single text field with clean focus states and a clear label.</span>
          <span class="preview-value muted" id="previewUsername">Nothing typed yet</span>
        </div>
        <div class="stat">
          <strong>Password</strong>
          <span>Secure-style password inputs with matching visual treatment.</span>
          <span class="preview-value muted" id="previewPassword">Nothing typed yet</span>
        </div>
        <div class="stat">
          <strong>Corner button</strong>
          <span>Always visible, pinned to the top-right corner of the page.</span>
          <div class="match-state warn" id="previewMatchState">Type both passwords to compare them.</div>
        </div>
      </aside>
    </section>
  </main>
</body>
</html>
